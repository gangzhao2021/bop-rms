{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bop-rms.local/schemas/module-manifest.schema.json",
  "title": "BOP-RMS Module Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleName",
    "packageName",
    "layer",
    "lifecycle",
    "publicExports",
    "allowedSynchronousDependencies",
    "consumedEvents",
    "publishedEvents",
    "ownedDatabase",
    "ownedJobs",
    "featureFlags",
    "killSwitches",
    "piiClassification",
    "moduleOwner"
  ],
  "properties": {
    "moduleName": { "$ref": "#/$defs/moduleName" },
    "packageName": { "$ref": "#/$defs/packageName" },
    "layer": { "enum": ["BOP", "RMS"] },
    "lifecycle": { "enum": ["Phase 0", "Phase 1", "Later"] },
    "publicExports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$" }
    },
    "allowedSynchronousDependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleDependency" }
    },
    "consumedEvents": { "$ref": "#/$defs/contractNameSet" },
    "publishedEvents": { "$ref": "#/$defs/contractNameSet" },
    "ownedDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "tables"],
      "properties": {
        "schema": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$" },
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    },
    "ownedJobs": { "$ref": "#/$defs/contractNameSet" },
    "featureFlags": { "$ref": "#/$defs/contractNameSet" },
    "killSwitches": { "$ref": "#/$defs/contractNameSet" },
    "piiClassification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classes", "handling"],
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "none",
              "indirect_identifier",
              "personal",
              "sensitive_personal",
              "payment",
              "health",
              "credential"
            ]
          }
        },
        "handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logs", "urls", "analytics", "fixtures"],
          "properties": {
            "logs": { "enum": ["prohibited", "redacted"] },
            "urls": { "const": "prohibited" },
            "analytics": { "enum": ["prohibited", "deidentified"] },
            "fixtures": { "const": "synthetic-only" }
          }
        }
      }
    },
    "moduleOwner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": { "role": { "type": "string", "minLength": 3, "pattern": "^[^<>]+$" } }
    }
  },
  "$defs": {
    "moduleDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleName", "packageName", "layer"],
      "properties": {
        "moduleName": { "$ref": "#/$defs/moduleName" },
        "packageName": { "$ref": "#/$defs/packageName" },
        "layer": { "enum": ["BOP", "RMS"] }
      }
    },
    "moduleName": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^@(bop|rms)/[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "contractNameSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
    }
  }
}
