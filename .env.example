# Copy to .env. This file contains paths and non-secret local defaults only.
# Create the password file separately with Linux mode 0600; never commit it.
BOP_RMS_POSTGRES_PASSWORD_FILE=.local/postgres/password
BOP_RMS_POSTGRES_PORT=5432
BOP_RMS_POSTGRES_DB=bop_rms_local
BOP_RMS_POSTGRES_USER=bop_rms_local
