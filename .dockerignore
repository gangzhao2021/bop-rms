# The pilot image is built from tracked source only. Runtime state, secrets and
# host-built outputs are never copied; the runtime directory is mounted at run time.
.git
# Agent worktrees and settings: a worktree is a whole second checkout, and 113 of them made
# the image 20 GB and filled the host disk (2026-11-13).
.claude
.local
.cache
.env
.env.*
!.env.example
**/node_modules
**/dist
**/.turbo
**/coverage
**/test-results
**/test-results-*
**/.playwright-*.config.ts
**/playwright-report
