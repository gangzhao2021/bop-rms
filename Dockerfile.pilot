# WP-2423 P1: single-store pilot runtime image.
# Installs and builds inside Linux so the existing /proc-based supervisor, process identity
# and health checks run unchanged. The runtime directory (configuration, keys, simulator)
# is mounted at /app/.local/<name> and never copied into the image.
FROM node:24.18.0-bookworm@sha256:5711a0d445a1af54af9589066c646df387d1831a608226f4cd694fc59e745059

RUN corepack enable
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm build
# InternalTest only: the local root entry and simulated-payment UI need this explicit
# customer build (single-store-pilot runbook). Leave unset for any real-payment image.
ARG VITE_BOP_INTERNAL_SIMULATED_PAYMENT=
RUN if [ "$VITE_BOP_INTERNAL_SIMULATED_PAYMENT" = "1" ]; then \
      VITE_BOP_INTERNAL_SIMULATED_PAYMENT=1 pnpm --filter @bop-rms/customer-pwa build; \
    fi

ENV NODE_ENV=development
ARG PILOT_RUNTIME_DIRECTORY=.local/pilot-v14
ENV PILOT_RUNTIME_DIRECTORY=${PILOT_RUNTIME_DIRECTORY}
CMD ["sh", "tooling/environment/pilot-container-start.sh"]
