{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format:check": {},
    "lint": {},
    "test": {},
    "test:integration": {},
    "typecheck": {},
    "screen-registry:check": {}
  }
}
