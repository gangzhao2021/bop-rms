{
  "name": "bop-rms",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "database-ownership:check": "vitest run tooling/database-ownership/validate.test.mjs && node tooling/database-ownership/validate.mjs",
    "db:migrate": "node packages/database/src/cli.ts",
    "domain-layer-boundary:check": "vitest run tooling/domain-layer-boundary/validate.test.mjs && node tooling/domain-layer-boundary/validate.mjs",
    "event-catalog:acceptance": "pnpm --filter @bop-rms/contracts-events test && pnpm --filter @bop-rms/contracts-events event-catalog:check",
    "event-catalog:check": "pnpm --filter @bop-rms/contracts-events event-catalog:check",
    "clean": "turbo run clean",
    "dev": "node tooling/environment/local.mjs start",
    "environment:check": "node tooling/environment/validate.mjs --env-file .env --check-ports",
    "environment:verify": "node tooling/environment/verify-local.mjs",
    "foundation:check": "vitest run packages/database/src/foundation.test.ts && node packages/database/src/foundation-cli.ts --help",
    "foundation:verify": "node packages/database/src/foundation-cli.ts",
    "helpers:check": "vitest run packages/database/src/helpers.test.ts && node packages/database/src/helpers-cli.ts --help",
    "helpers:verify": "node packages/database/src/helpers-cli.ts",
    "isolated-database:acceptance": "node packages/database/test/isolated-database-acceptance.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check . && turbo run format:check",
    "import-boundary:check": "vitest run tooling/import-boundary/validate.test.mjs && node tooling/import-boundary/validate.mjs",
    "lint": "eslint . && turbo run lint",
    "local:status": "node tooling/environment/local.mjs status",
    "local:stop": "node tooling/environment/local.mjs stop",
    "module-generator": "node tooling/module-generator/generate.mjs",
    "module-generator:check": "vitest run tooling/module-generator/generate.test.mjs",
    "module-manifest:check": "node tooling/module-manifest/validate.mjs",
    "migration:check": "vitest run packages/database/src/catalog.test.ts packages/database/src/config.test.ts && node packages/database/src/check.ts",
    "outbox:acceptance": "vitest run --config packages/database/vitest.outbox.config.ts",
    "outbox-dispatcher:acceptance": "vitest run --config packages/database/vitest.outbox-dispatcher.config.ts",
    "consumer-inbox:acceptance": "vitest run --config packages/database/vitest.consumer-inbox.config.ts",
    "correlation-context:acceptance": "vitest run --config packages/database/vitest.correlation-context.config.ts",
    "retry-dead-letter:acceptance": "vitest run --config packages/database/vitest.retry-dead-letter.config.ts",
    "repository-guidance:check": "node tooling/repository-guidance/validate.mjs",
    "realtime:acceptance": "pnpm --filter @bop-rms/api realtime:acceptance",
    "test": "vitest run && turbo run test",
    "test:integration": "turbo run test:integration",
    "typecheck": "tsc --project tsconfig.json && turbo run typecheck",
    "verify": "pnpm repository-guidance:check && pnpm module-manifest:check && pnpm module-generator:check && pnpm import-boundary:check && pnpm database-ownership:check && pnpm domain-layer-boundary:check && pnpm migration:check && pnpm foundation:check && pnpm helpers:check && pnpm event-catalog:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm screen-registry:check && pnpm test && pnpm build",
    "screen-registry:check": "node tooling/screen-registry/validate.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10",
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
