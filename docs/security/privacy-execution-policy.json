{
  "schemaVersion": 1,
  "authority": [
    "BOP-RMS Handoff 86.9",
    "BOP-RMS Handoff 87.10.1",
    "BOP-RMS Handoff 87.10.2",
    "Repository-accepted WP-2234 and WP-2240 credential handoff"
  ],
  "unknownClassification": "Confidential",
  "prohibitedData": ["PAN", "CVV", "raw-authentication-credential"],
  "necessaryCookies": [
    {
      "name": "__Host-bop-auth",
      "purpose": "merchant-oauth-transaction",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null
    },
    {
      "name": "__Host-bop-merchant",
      "purpose": "merchant-session",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null
    },
    {
      "name": "__Host-bop-guest",
      "purpose": "guest-session",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null
    },
    {
      "name": "__Host-bop-platform-auth",
      "purpose": "platform-oauth-transaction",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null
    },
    {
      "name": "__Host-bop-platform",
      "purpose": "platform-operator-session",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null
    },
    {
      "name": "__Host-bop-store-device",
      "purpose": "registered-store-tablet-for-staff-pin-switch",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Strict",
      "path": "/",
      "domain": null,
      "persistence": "400-days-browser-maximum",
      "serverAuthority": "Identity store sign-in device registration; only an HMAC-SHA256 of the secret is stored and revocation is server-side",
      "sourceFiles": ["apps/api/src/merchant-staff-pin-http.ts"],
      "design": "docs/spec/design/staff-session-continuity.md",
      "webStorage": false
    },
    {
      "name": "__Host-bop-step-up",
      "purpose": "staff-reauthentication-window-for-approvals",
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null,
      "persistence": "10-minutes",
      "serverAuthority": "Identity OIDC authorization transaction; only a hash of the value is stored, single use, cleared when the re-authentication returns",
      "sourceFiles": [
        "apps/api/src/merchant-bff-session-routes.ts",
        "apps/api/src/merchant-provider-step-up.ts"
      ],
      "design": "docs/spec/design/cognito-store-staff.md",
      "webStorage": false
    }
  ],
  "prohibitedTracking": [
    "advertising-cookie",
    "cross-site-tracker",
    "third-party-analytics",
    "fingerprinting",
    "session-replay",
    "email-open-tracking",
    "email-click-tracking",
    "tracking-pixel"
  ],
  "marketing": {
    "enabled": false,
    "futureRequires": [
      "consent-evidence",
      "withdrawal-or-unsubscribe",
      "privacy-review",
      "CASL-review"
    ]
  },
  "privacyRights": {
    "types": ["AccessPortability", "Correction", "ConsentWithdrawal", "DeletionAnonymization"],
    "trackedRequestRequired": true,
    "proportionalIdentityProof": true,
    "responseTargetCalendarDays": 30,
    "exportEncrypted": true,
    "exportSingleUse": true,
    "exportMaximumHours": 24,
    "unencryptedEmailAttachment": false,
    "preserveFinancialAndAuditHistory": true,
    "legalHoldOrStatutoryBlockReasonRequired": true
  },
  "privacyTombstone": {
    "allowedFields": [
      "opaqueSubjectId",
      "fieldReference",
      "policyVersion",
      "completedAt",
      "replayStatus"
    ],
    "prohibitedFields": ["email", "phone", "name"],
    "productSearch": false,
    "analytics": false,
    "applyBeforeRestoredTraffic": true
  },
  "retention": [
    {
      "class": "business-record",
      "period": "P7Y",
      "trigger": "fiscal-year-end",
      "legalHoldExtends": true
    },
    {
      "class": "corporate-permanent-record",
      "period": "INDEFINITE",
      "trigger": "record-created",
      "legalHoldExtends": true
    },
    {
      "class": "unnecessary-customer-contact",
      "period": "P24M",
      "trigger": "last-closed-transaction",
      "legalHoldExtends": true
    },
    {
      "class": "raw-provider-payload",
      "period": "P30D",
      "trigger": "received-at",
      "legalHoldExtends": true
    },
    {
      "class": "application-log",
      "period": "P30D",
      "trigger": "recorded-at",
      "legalHoldExtends": false
    },
    {
      "class": "security-audit-archive",
      "period": "P365D",
      "trigger": "recorded-at",
      "legalHoldExtends": true
    },
    {
      "class": "import-result-artifact",
      "period": "P90D",
      "trigger": "completed-at",
      "legalHoldExtends": true
    },
    {
      "class": "development-staging-data",
      "period": "P7D",
      "trigger": "created-at",
      "legalHoldExtends": false
    }
  ],
  "externalEvidenceRequired": true,
  "necessaryCookieFamilies": [
    {
      "prefix": "__Host-bop-guest-candidate-",
      "suffixFormat": "uuid-v7-operation-reference",
      "purpose": "guest-binding-candidate-handoff",
      "sourceFiles": ["apps/api/src/customer-cart-binding.ts"],
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null,
      "persistence": "browser-session",
      "serverAuthority": "Identity preparation and Session deadlines",
      "clearOn": "successful activation or completion of the same operation",
      "webStorage": false
    },
    {
      "prefix": "__Host-bop-guest-dining-candidate-",
      "suffixFormat": "uuid-v7-operation-reference",
      "purpose": "guest-dining-binding-candidate-handoff",
      "sourceFiles": ["apps/api/src/customer-dining-binding.ts"],
      "secure": true,
      "httpOnly": true,
      "sameSite": "Lax",
      "path": "/",
      "domain": null,
      "persistence": "browser-session",
      "serverAuthority": "Identity preparation and Session deadlines",
      "clearOn": "successful activation or completion of the same operation",
      "webStorage": false
    }
  ]
}
