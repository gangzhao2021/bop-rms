{
  "name": "@bop-rms/customer-pwa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "lint": "eslint src scripts vite.config.ts",
    "pwa:verify": "vite build && node scripts/verify-service-worker.mjs",
    "pwa-security:acceptance": "vitest run src/App.test.tsx src/pwa/service-worker-policy.test.ts src/pwa/update-store.test.ts src/cart/cart-state.test.ts src/checkout/checkout-client.test.ts src/payment/payment-controller.test.ts && pnpm pwa:verify",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.service-worker.json"
  },
  "dependencies": {
    "@bop-rms/ui": "workspace:*",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "tailwindcss": "4.3.2",
    "vite": "8.1.4",
    "vite-plugin-pwa": "1.3.0",
    "workbox-cacheable-response": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
