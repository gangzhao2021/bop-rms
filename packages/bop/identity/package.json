{
  "name": "@bop/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/packages/bop/identity/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "browser-session:acceptance": "vitest run --config vitest.config.ts src/tests/browser-session.test.ts",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
    "guest-session:acceptance": "vitest run --config vitest.config.ts src/tests/guest-session.test.ts",
    "identity-session:acceptance": "vitest run --config vitest.config.ts src/tests/identity-session-contract.test.ts",
    "lint": "eslint src",
    "test": "vitest run --config vitest.config.ts",
    "workforce-identity-security:acceptance": "vitest run --config vitest.config.ts src/tests/workforce-identity-security.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "3.1087.0",
    "@bop/audit": "workspace:*",
    "aws-jwt-verify": "5.2.1",
    "openid-client": "6.8.4",
    "uuid": "14.0.1"
  }
}
