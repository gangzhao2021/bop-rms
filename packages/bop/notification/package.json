{
  "name": "@bop/notification",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/packages/bop/notification/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "format:check": "prettier --check . --ignore-path ../../../.prettierignore",
