{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "const": "additive",
      "type": "string"
    },
    "consumers": {
      "items": {
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*:v[1-9][0-9]*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "dataClassification": {
      "enum": [
        "none",
        "indirect_identifier",
        "personal",
        "sensitive_personal",
        "payment",
        "health",
        "credential"
      ],
      "type": "string"
    },
    "deprecated": {
      "type": "boolean"
    },
    "eventType": {
      "pattern": "^[A-Z][A-Za-z0-9]{0,127}$",
      "type": "string"
    },
    "ownerModule": {
      "pattern": "^@(bop|rms)\\/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "producerModule": {
      "pattern": "^@(bop|rms)\\/[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "replacement": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Za-z0-9]{0,127}:v[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaySemantics": {
      "enum": ["idempotent", "owner_approved_only", "not_replayable"],
      "type": "string"
    },
    "retentionCategory": {
      "enum": ["operational_short", "operational_standard", "business_record"],
      "type": "string"
    },
    "schemaVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
    },
    "stability": {
      "enum": ["experimental", "stable", "deprecated"],
      "type": "string"
    },
    "tenantScope": {
      "enum": ["brand", "store"],
      "type": "string"
    }
  },
  "required": [
    "eventType",
    "schemaVersion",
    "ownerModule",
    "producerModule",
    "stability",
    "consumers",
    "tenantScope",
    "dataClassification",
    "compatibility",
    "retentionCategory",
    "replaySemantics",
    "deprecated",
    "replacement"
  ],
  "type": "object"
}
