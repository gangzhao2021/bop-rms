    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$/u"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          }
        },
        "required": [
          "schemaVersion"
        ],
        "additionalProperties": {}
      },
      "QuoteErrorResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "quote_request_invalid",
                  "quote_not_found",
                  "quote_version_conflict",
                  "quote_idempotency_conflict",
                  "quote_configuration_invalid",
                  "quote_service_unavailable"
                ]
              },
              "messageKey": {
                "type": "string",
                "pattern": "^customer\\.quote\\.[a-z_]+$/u"
              }
            },
            "required": [
              "code",
              "messageKey"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schemaVersion",
          "error"
        ],
        "additionalProperties": false
      },
      "QuoteOperationExpiredResponse": {
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "number",
            "enum": [
              1
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "quote_operation_expired"
                ]
              },
              "messageKey": {
                "type": "string",
                "enum": [
                  "customer.quote.operation_expired"
                ]
              }
            },
            "required": [
              "code",
              "messageKey"
            ],
            "additionalProperties": false
          },
          "resolution": {
            "type": "object",
            "properties": {
              "operationReference": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u"
              },
              "cartReference": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u"
              },
              "cartVersion": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "operationReference",
              "cartReference",
              "cartVersion"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "schemaVersion",
          "error",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
