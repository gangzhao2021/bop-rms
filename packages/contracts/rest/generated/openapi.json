    "/api/v1/carts/{cart_id}/quote": {
      "post": {
        "description": "Current Guest Session and exact Store/Cart authorization required. Ordering owns the expiry resolution; Checkout consumes this no-store, request-bound receipt. Internal scoped references only; no credentials or personal facts in responses. Repeat the original operation while unknown. A persisted expiry permits an explicit new operation; it never renews the original Quote.",
        "operationId": "quoteCart",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "example": "018f0f58-767a-7f3b-a1d0-000000000001"
            },
            "required": true,
            "name": "cart_id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/u"
            },
            "required": true,
            "name": "idempotency-key",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$/u"
            },
            "required": true,
            "name": "x-csrf-token",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "origin",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "same-origin"
              ]
            },
            "required": true,
            "name": "sec-fetch-site",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$/u"
            },
            "required": true,
            "name": "__Host-bop-guest",
            "in": "cookie"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cartVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                },
                "required": [
                  "cartVersion"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful public contract response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "201": {
            "description": "Original immutable Quote created or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "description": "Safe request rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Permission denied without object disclosure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Current Session or Cart not available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Idempotency or expected-version conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "Original operation is durably expired; late attachment is fenced. Explicit new operation is allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteOperationExpiredResponse"
                }
              }
            }
          },
          "422": {
            "description": "Quote configuration invalid; not an expiry receipt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Safe internal failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Outcome unavailable or unknown; preserve original operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteErrorResponse"
                }
              }
            }
          }
        }
      }
    },
